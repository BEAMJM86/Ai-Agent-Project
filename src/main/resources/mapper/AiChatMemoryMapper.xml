<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yupi.yuaiagent.mapper.AiChatMemoryMapper">

    <resultMap id="AiChatMemoryEntityMap" type="com.yupi.yuaiagent.domain.dto.AiChatMemoryEntity">
        <id column="id" property="id"/>
        <result column="conversation_id" property="conversationId"/>
        <result column="messages_blob" property="messagesBlob" jdbcType="BLOB"/>
        <result column="msg_count" property="msgCount"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectByConversationId" resultMap="AiChatMemoryEntityMap">
        SELECT id, conversation_id, messages_blob, msg_count, updated_at
        FROM ai_chat_memory
        WHERE conversation_id = #{conversationId}
            LIMIT 1
    </select>

    <insert id="upsert">
        INSERT INTO ai_chat_memory (conversation_id, messages_blob, msg_count)
        VALUES (#{conversationId}, #{messagesBlob,jdbcType=BLOB}, #{msgCount})
            ON DUPLICATE KEY UPDATE
                                 messages_blob = VALUES(messages_blob),
                                 msg_count = VALUES(msg_count)
    </insert>

    <delete id="deleteByConversationId">
        DELETE FROM ai_chat_memory WHERE conversation_id = #{conversationId}
    </delete>

</mapper>
